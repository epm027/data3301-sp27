library(tidyverse)
counter <- 0
num.int <- 100
n <- 10
true.theta <- 1
lowers <- c()
uppers <- c()
for(b in 1:num.int){
X <- runif(n, 0, true.theta)
lower.endpoint <- mean(X) - 1.96 / sqrt(12 * n)
upper.endpoint <- mean(X) + 1.96 / sqrt(12 * n)
lowers <- c(lowers, lower.endpoint)
uppers <- c(uppers, upper.endpoint)
if((true.theta >= lower.endpoint) &
(true.theta <= upper.endpoint)) {
counter <- counter + 1
}
}
badind <- which(
(uppers < true.theta) |
(lowers > true.theta)
)
base.plot <- data.frame(x = 1:num.int,
lowers,
uppers) %>%
ggplot(aes(x = x)) +
geom_segment(aes(x = x, xend = x,
y = lowers, yend = uppers))
for(k in badind) {
base.plot <- base.plot +
annotate(
geom = "segment",
x = (1:num.int)[k],
xend = (1:num.int)[k],
y = lowers[k],
yend = uppers[k],
col = "red"
)
}
